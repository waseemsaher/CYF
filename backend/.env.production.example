# ==============================================================================
# Codeera Backend — Production Environment Configuration Template
# Copy this file to .env on your production host and replace placeholder values.
# ==============================================================================

APP_NAME=Codeera
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Allowed origin of your deployed frontend (e.g. Vercel, Netlify, or custom domain)
FRONTEND_URL=https://your-frontend-app.vercel.app
SANCTUM_STATEFUL_DOMAINS=yourdomain.com,your-frontend-app.vercel.app

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Database (MySQL 8.4)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cyf
DB_USERNAME=cyf
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_TO_SECURE_ROOT_PASSWORD

# ------------------------------------------------------------------------------
# Redis (Cache, Sessions, Queues)
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ------------------------------------------------------------------------------
# File Storage (Local Docker volume or AWS S3 / DigitalOcean Spaces)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local
# If using S3 / DigitalOcean Spaces, uncomment and configure:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# Email / Mailer (Transactional: Resend, Brevo, Mailgun, or standard SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=re_your_api_key_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Telegram Bot Integration
# ------------------------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
# Bot username without @
TELEGRAM_BOT_USERNAME="CodeeraBot"
# Random secret token sent in X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET="generate-a-strong-random-string-here"
