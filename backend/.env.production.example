# ==============================================================================
# Codeera Backend — Production Environment Configuration (.env)
# ==============================================================================
# Place this file as /var/www/cyf/.env (or /var/www/cyf/backend/.env) on the host.
# NEVER commit this file or bake it into container images.
# ==============================================================================

APP_NAME=Codeera
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.codeera.tech

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# ------------------------------------------------------------------------------
# Frontend & Cross-Origin Auth (Sanctum SPA across subdomains)
# ------------------------------------------------------------------------------
FRONTEND_URL=https://codeera.tech
CORS_ALLOWED_ORIGINS="https://codeera.tech,https://app.codeera.tech"
SANCTUM_STATEFUL_DOMAINS="codeera.tech,app.codeera.tech"

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.codeera.tech
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Reverse Proxy & SSL (Caddy)
# ------------------------------------------------------------------------------
SERVER_NAME=api.codeera.tech
ACME_EMAIL=admin@codeera.tech
HTTP_PORT=80
HTTPS_PORT=443

# ------------------------------------------------------------------------------
# Database (Self-managed MySQL 8 container — NO AWS RDS)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cyf
# Dedicated least-privilege app user for Laravel
DB_USERNAME=cyf_user
DB_PASSWORD=GENERATE_STRONG_APP_PASSWORD_HERE
# MySQL root administrative password (container internal only, not used by Laravel)
DB_ROOT_PASSWORD=GENERATE_STRONG_ROOT_PASSWORD_HERE

# ------------------------------------------------------------------------------
# Redis (Self-managed Redis 7 container — NO AWS ElastiCache)
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=GENERATE_STRONG_REDIS_PASSWORD_HERE

QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ------------------------------------------------------------------------------
# Object Storage (AWS S3 Private Bucket — swapped to Oracle Object Storage later)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=codeera-media
AWS_BACKUP_BUCKET=codeera-backups
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# Email / Mailer (Default to 'log' for pilot; switch to 'smtp' when provider is active)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key_here
MAIL_FROM_ADDRESS="noreply@codeera.tech"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Telegram Bot Integration
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME="CodeeraBot"
TELEGRAM_WEBHOOK_SECRET=
