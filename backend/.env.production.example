# ==============================================================================
# Al-Azhar FCAI Course Platform - Production Backend Environment Template
# Copy this file to .env on the production server: cp .env.production.example .env
# ==============================================================================

APP_NAME="Codeera"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Cairo
APP_URL=https://courses.fcai-azhar.edu.eg
FRONTEND_URL=https://courses.fcai-azhar.edu.eg

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# Logging
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_STACK=single

# Database (Production MySQL 8.4)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cyf
DB_USERNAME=cyf_user
DB_PASSWORD=your_strong_mysql_password_here

# Session & Cookies (HTTPS-only)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.fcai-azhar.edu.eg
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Cache & Queue (Redis 7)
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=cyf_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (Transactional SMTP / Resend / Postmark / Mailgun)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@courses.fcai-azhar.edu.eg
MAIL_PASSWORD=your_smtp_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@courses.fcai-azhar.edu.eg"
MAIL_FROM_NAME="منصة كورسات حاسبات الأزهر"

# DigitalOcean Spaces (S3-Compatible Object Storage for Private Course Files & Proofs)
AWS_ACCESS_KEY_ID=your_do_spaces_key
AWS_SECRET_ACCESS_KEY=your_do_spaces_secret
AWS_DEFAULT_REGION=fra1
AWS_BUCKET=cyf-storage
AWS_ENDPOINT=https://fra1.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=Facultylmsbot
TELEGRAM_WEBHOOK_SECRET=your_random_64char_webhook_secret_here

# Business Settings Defaults
PLATFORM_DEFAULT_TEACHER_SHARE=70
PLATFORM_GRACE_PERIOD_DAYS=3
